# Django
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Database (PostgreSQL)
# NB: when running via `docker compose up`, web/worker override DATABASE_URL
# to point at the `db` service automatically — this value is used for running
# manage.py directly on the host (outside Docker).
DATABASE_URL=postgres://cookpilot:cookpilot@localhost:5432/cookpilot
POSTGRES_DB=cookpilot
POSTGRES_USER=cookpilot
POSTGRES_PASSWORD=cookpilot

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS (frontend origin)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Mistral AI
MISTRAL_API_KEY=
MISTRAL_VISION_MODEL=pixtral-12b-2409
MISTRAL_CHAT_MODEL=mistral-large-latest
